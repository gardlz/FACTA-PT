# Copy to .env and fill in. .env is git-ignored: it holds the LUSA API account.

# Port the website answers on.
WEB_PORT=8000

# LUSA search API account; the API only answers over its VPN. Without it, a new claim stops
# before retrieval.
API_URL_LUSA=
USER_LUSA=
PASSWORD_LUSA=
LUSA_DATASET=LUSA

# Inference service, and how long (seconds) the website waits for each call; a call may first
# wait for another run's article.
INFERENCE_URL=http://inference:8100
INFERENCE_TIMEOUT=900

# Model weights, mounted at /checkpoints in the inference container. QG_MODEL_PATH may also be
# a Hugging Face id (amalia-llm/AMALIA-9B-0626-DPO); the adapter is always local.
CHECKPOINTS_DIR=./checkpoints
QG_MODEL_PATH=/checkpoints/qg
QG_ADAPTER_PATH=/checkpoints/qg_adapter
RELEVANCE_MODEL_PATH=/checkpoints/relevance
STANCE_MODEL_PATH=/checkpoints/stance
# GPUs reserved by docker-compose.gpu.yml. The models use the first one.
INFERENCE_GPUS=1

# Article writer: Gemma 4 E4B at the revision evaluated in the dissertation, or a local path.
# ARTICLE_DEVICE: auto (the GPU when it can hold the model, else the CPU), cuda or cpu.
ARTICLE_MODEL_PATH=google/gemma-4-E4B-it
ARTICLE_MODEL_REVISION=ee0ef6023621cff504d758262d4e04895a5af4a2
ARTICLE_DEVICE=auto
# Token budget of the article's prompt (about 60 passages). Past it, the passages worth least
# are left out, never the last one of a relation.
ARTICLE_MAX_PROMPT_TOKENS=16384
# How long (seconds) the website waits for an article, queue included. The inference service
# gets this deadline, less two minutes, and sends back what it has written by then.
ARTICLE_TIMEOUT=10800

# Distinct news items kept per question, once reissues are merged.
TOP_K_PER_QUESTION=5

# Finished runs, kept so the news behind each citation can be served, and how many to keep.
# Replicas behind a load balancer need a shared volume here.
RUN_STORE_DIR=/tmp/facta-pt/execucoes
RUN_RETENTION=64

# Website processes and concurrent runs per process (at most WEB_WORKERS x MAX_CONCURRENT_RUNS
# in all); past that, a request waits RUN_QUEUE_TIMEOUT seconds and is then asked to retry.
WEB_WORKERS=2
MAX_CONCURRENT_RUNS=4
RUN_QUEUE_TIMEOUT=20

# Allowed origins when the website is served from another domain (comma-separated).
CORS_ORIGINS=
