# This deployment's configuration: copy to .env and fill in. .env is git-ignored: it holds the
# news API account and the password gate's secrets.

# Port the website answers on.
WEB_PORT=8000

# LUSA news API (AmaliaDB); it only answers over the VPN. Without these, a new claim stops
# before retrieval. The worked examples need none of it.
API_URL_LUSA="http://<host>:8080"
USER_LUSA=
PASSWORD_LUSA=
LUSA_DATASET=LUSA

# Inference service, and how long (seconds) the website waits for it.
INFERENCE_URL=http://inference:8100
INFERENCE_TIMEOUT=3600

# The two AMALIA models - the question generator, AMALIA-9B-0626-DPO with FACT-PT's adapter
# (liaad/facta-pt-qg-amalia-9b-0626-dpo), and the article writer, AMALIA-9B-0626-DPO itself - answer
# on Modal, behind one gateway (MODELS.md): its address, without a path, and its key.
MODAL_API_URL=
MODAL_API_KEY=
# Seconds the gateway's GPU stays on after a request (its scaledown_window): the page shows the two
# models as ready for that long, and afterwards as loading when a run needs them.
# MODAL_GPU_IDLE_S=60
# Without MODAL_API_URL, each behind an OpenAI-compatible API of its own (vLLM, say: MODELS.md): its
# address, with or without /v1 (http://host.docker.internal:8001/v1 for a server on this machine,
# say), the name the model is served under, and the API's key, if it asks for one.
# QG_API_URL=
# QG_API_MODEL=
# QG_API_KEY=
# AMALIA_API_URL=
# AMALIA_API_MODEL=
# AMALIA_API_KEY=

# The Gemma article writer, on OpenRouter (https://openrouter.ai): the account's key, and the model.
# Paid, the article's schema and the repetition penalty are honoured; the `:free` variant takes no
# repetition penalty, is rate-limited, and may write the article without its schema (MODELS.md). Changing the model takes a restart of the
# inference service: `docker compose up -d inference`.
ARTICLE_API_KEY=
# ARTICLE_API_MODEL=google/gemma-4-31b-it
# ARTICLE_API_MODEL=google/gemma-4-31b-it:free
# Seconds a request to any API may take; an article's, at most what its deadline leaves.
# API_TIMEOUT_S=3600

# The models that run here, the two classifiers. By default Hugging Face ids, downloaded once into
# the `modelos` volume on first start (about 3 GB in all, with the tokenizers the question
# generator and the writers count their prompts with), with their revisions pinned in
# docker-compose.yml.
#
# Or local folders, one per model, mounted read-only at /checkpoints: what a server should use (no
# download, works offline). Fill the folder with scripts/exportar-modelos.sh (MODELS.md) and
# uncomment this block. Not on Windows/Docker Desktop: a folder mounted from the Windows disk
# is read far more slowly than the volume.
# CHECKPOINTS_DIR=/srv/facta-pt/checkpoints
# QG_MODEL_PATH=/checkpoints/AMALIA-9B-0626-DPO
# QG_ADAPTER_PATH=/checkpoints/facta-pt-qg-amalia-9b-0626-dpo
# RELEVANCE_MODEL_PATH=/checkpoints/facta-pt-relevance-bertimbau-base
# STANCE_MODEL_PATH=/checkpoints/facta-pt-cee-xlm-roberta-large-xnli
# GPUs reserved by docker-compose.gpu.yml.
INFERENCE_GPUS=1
# Seconds a model may sit unused on the GPU before it leaves it (the next claim brings it back in
# seconds), so that a card holding every model does not keep them there while nobody verifies. 0
# keeps them there until another model needs the room.
# GPU_IDLE_TTL_S=600
# Seconds a model may sit unused before it is let go of main memory too, and the memory goes back
# to the machine. The next claim loads it again from disk, in seconds. Keep it above the GPU's. 0
# keeps them loaded.
# RAM_IDLE_TTL_S=1800
# Under Windows/WSL the GPU driver lends system memory when the card is full; when that is not
# detected (GPU-GUIDE.md), set it:
# GPU_LENDS_MEMORY=true

# Distinct news items kept per question, once reissues are merged.
TOP_K_PER_QUESTION=5

# Finished runs, kept so the documents behind each citation can be served: written by the
# worker, read by the website, in the folder both mount (docker-compose.yml). The folder also
# holds the accounts, the platform settings and the reviews. By default it is `dados/` beside this
# file; set RUNS_DIR to keep it elsewhere (an absolute path is fine). On a Linux host the folder
# must belong to the containers' user: `sudo chown -R 100:101 dados`.
# RUNS_DIR=./dados
RUN_RETENTION=64
# Verifications that ran to their end are kept apart, each one at an address of its own
# (/verificacao/<id>) that opens it again. They are kept for good; set a number to keep only that
# many, the oldest going first. Their news text is kept too, a few hundred kB each.
SAVED_RETENTION=0

# Website processes. Runs that use the models wait in a queue (Redis) and the worker takes them
# one at a time; QUEUE_MAX may wait, past them a new one is asked to try again later. More runs
# at once: docker compose up -d --scale worker=2.
WEB_WORKERS=2
QUEUE_MAX=20
# Runs one browser session may have waiting or under way at once, and one client address (0, no
# limit). Under Docker's port publishing every client may show the same address, so the address
# limit is off: turn it on behind a reverse proxy that passes the client's address on.
RUNS_PER_SESSION=2
RUNS_PER_ADDRESS=0
# The client address comes from X-Forwarded-For only when a trusted reverse proxy sends it;
# from anyone else it is ignored, or a client could pick its own address and get round the
# sign-in throttle and the address limit. With no proxy (http://localhost:8000) leave it out.
# Behind one on the host, the gateway of the project's Docker network, which is where the web
# container sees it connect from (SERVER-GUIDE.md, step 5) — the same with Tailscale Funnel:
# FORWARDED_ALLOW_IPS=172.18.0.1

# Allowed origins when the website is served from another domain (comma-separated).
CORS_ORIGINS=

# Accounts and roles (web/app/utilizadores.py). There is no shared password: each person signs in
# with their own account, and an administrator makes the others in /administracao.
#
# The first administrator is made on the first start, when there are no accounts yet. Generate the
# hash with `python -m app.acesso` in `web/` (or in the image); it prints the two lines below. The
# hash holds `$`, so it stays in single quotes.
# ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# An older deployment may still have the shared password: it makes the first administrator too,
# and is not accepted for signing in afterwards.
ACCESS_PASSWORD_HASH=

# The accounts and the platform settings (roles, permissions, defaults). By default they sit on the
# data volume, beside the runs' folder; the reviews of saved verifications are kept inside that
# folder, in `revisoes/`. Set these only to move them elsewhere.
# UTILIZADORES_FILE=
# PLATAFORMA_FILE=

# Over plain HTTP (http://localhost:8000) the session cookie cannot be Secure: false to try the
# site locally. Behind HTTPS leave it out.
# COOKIE_SECURE=false
